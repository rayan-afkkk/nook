# Copy to .env and fill in. Never commit .env.
# Every value here is a *public client* identifier; real secrets live only in the Worker (wrangler secret).

# Firebase console > Authentication > Sign-in method > Google > Web SDK configuration > "Web client ID".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Cloudflare Worker URL printed by `npx wrangler deploy` (see worker/README.md).
EXPO_PUBLIC_WORKER_URL=

# Cloudinary > Settings > Product environment: "Cloud name", and the name of your UNSIGNED upload preset.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# developers.giphy.com > Create an App > API > key.
EXPO_PUBLIC_GIPHY_API_KEY=
