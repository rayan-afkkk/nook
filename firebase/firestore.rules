rules_version = '2';

// NOOK Firestore security rules.
// Only chat members can read or write a chat. Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Keep in sync with src/features/profile/username.ts
    function validUsername(name) {
      return name is string
        && name.matches('^[a-z][a-z0-9._]{1,18}[a-z0-9]$')
        && !name.matches('.*[.][.].*')
        && !(name in ['admin', 'administrator', 'nook', 'nookapp', 'support', 'help', 'official',
                      'system', 'root', 'moderator', 'mod', 'staff', 'team', 'security', 'null',
                      'undefined', 'me', 'you', 'everyone']);
    }

    function validDisplayName(v) {
      return v is string && v.size() > 0 && v.size() <= 40;
    }

    function validPhoto(v) {
      return v == null || (v is string && v.size() <= 1024 && v.matches('^https://.*'));
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function usernamePath(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }

    // users/{uid}: public profile. Readable one at a time by any signed-in user
    // (needed to show friends), never listable, writable only by its owner.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;

      // Created together with usernames/{username} in one transaction.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'displayName', 'photoURL', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'username', 'displayName', 'createdAt'])
        && request.resource.data.uid == uid
        && validUsername(request.resource.data.username)
        && validDisplayName(request.resource.data.displayName)
        && validPhoto(request.resource.data.get('photoURL', null))
        && request.resource.data.createdAt == request.time
        && getAfter(usernamePath(request.resource.data.username)).data.uid == uid;

      // The username is permanent: only display name and photo can change.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL'])
        && validDisplayName(request.resource.data.displayName)
        && validPhoto(request.resource.data.get('photoURL', null));

      allow delete: if isSelf(uid);
    }

    // usernames/{name}: { uid } reservation. Exact-name lookups only; no enumeration.
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;

      // One username per account, claimed atomically with the profile, and never overwritten
      // (an existing name is an update, which is always denied).
      allow create: if signedIn()
        && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !exists(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.username == name;

      allow update: if false;

      // Only released when the owner deletes their account (profile removed in the same batch).
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && !existsAfter(userPath(request.auth.uid));
    }

    // ---------------------------------------------------------------- chats

    function isMemberOf(data) {
      return signedIn() && request.auth.uid in data.members;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function mapChangedOnlyMine(field) {
      return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([request.auth.uid]);
    }

    function validDisappearing(v) {
      return v in ['off', '24h', '7d'];
    }

    // dm_<uidA>_<uidB>, sorted: the only DM between two people.
    function isMyDmId(chatId) {
      return chatId.matches('dm_[A-Za-z0-9]+_[A-Za-z0-9]+') && request.auth.uid in chatId.split('_');
    }

    function validNewChat(chatId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'name', 'photoURL', 'members', 'createdBy', 'createdAt', 'lastMessage', 'lastMessageAt', 'lastRead', 'mutedBy', 'disappearing'])
        && d.createdBy == request.auth.uid
        && request.auth.uid in d.members
        && d.members is list
        && d.createdAt == request.time
        && d.lastMessageAt == request.time
        && d.lastRead.keys().hasOnly([request.auth.uid])
        && d.mutedBy == []
        && validDisappearing(d.disappearing)
        && (
          (d.type == 'direct'
            && d.members.size() == 2
            && chatId == 'dm_' + d.members[0] + '_' + d.members[1]
            && d.members[0] < d.members[1]
            && exists(userPath(d.members[0])) && exists(userPath(d.members[1])))
          ||
          (d.type == 'group'
            && d.members.size() >= 2 && d.members.size() <= 32
            && d.name is string && d.name.size() > 0 && d.name.size() <= 40)
        );
    }

    match /chats/{chatId} {
      // A DM that doesn't exist yet may be looked up by either of its two people.
      allow get: if signedIn() && (resource == null ? isMyDmId(chatId) : isMemberOf(resource.data));
      allow list: if signedIn() && isMemberOf(resource.data);
      allow create: if signedIn() && validNewChat(chatId);
      allow delete: if false;

      allow update: if isMemberOf(resource.data) && (
        // Read receipt: only my own lastRead entry.
        (changed().hasOnly(['lastRead']) && mapChangedOnlyMine('lastRead'))
        // Sending: last message preview written by me, with my lastRead.
        || (changed().hasOnly(['lastMessage', 'lastMessageAt', 'lastRead'])
            && request.resource.data.lastMessage.senderId == request.auth.uid
            && request.resource.data.lastMessageAt == request.time
            && mapChangedOnlyMine('lastRead'))
        // Deleting my latest message.
        || (changed().hasOnly(['lastMessage']) && request.resource.data.lastMessage.senderId == request.auth.uid
            && request.resource.data.lastMessage.kind == 'deleted')
        // Mute / unmute: only myself.
        || (changed().hasOnly(['mutedBy'])
            && request.resource.data.mutedBy.toSet().difference(resource.data.mutedBy.toSet())
                 .union(resource.data.mutedBy.toSet().difference(request.resource.data.mutedBy.toSet()))
                 .hasOnly([request.auth.uid]))
        // Disappearing timer: any member.
        || (changed().hasOnly(['disappearing']) && validDisappearing(request.resource.data.disappearing))
        // Groups: rename, add people, or leave (remove only myself).
        || (resource.data.type == 'group' && changed().hasOnly(['name', 'photoURL'])
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40)
        || (resource.data.type == 'group' && changed().hasOnly(['members'])
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() <= 32)
        || (resource.data.type == 'group' && changed().hasOnly(['members'])
            && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()))
      );

      // ------------------------------------------------------------ messages
      match /messages/{messageId} {
        function chatData() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        function validMedia(m) {
          return m.keys().hasOnly(['url', 'publicId', 'resourceType', 'width', 'height', 'size', 'name', 'mime', 'durationMs', 'waveform', 'previewUrl'])
            && m.url is string && m.url.size() < 2048
            && (m.url.matches('^https://res[.]cloudinary[.]com/.*') || m.url.matches('^https://media[0-9]*[.]giphy[.]com/.*') || m.url.matches('^https://i[.]giphy[.]com/.*'))
            && (!('size' in m) || m.size <= 10 * 1024 * 1024)
            && (!('waveform' in m) || m.waveform.size() <= 64);
        }

        function validMessage() {
          let d = request.resource.data;
          return d.keys().hasOnly(['senderId', 'kind', 'text', 'media', 'replyTo', 'reactions', 'forwarded', 'createdAt', 'expireAt'])
            && d.senderId == request.auth.uid
            && d.createdAt == request.time
            && d.kind in ['text', 'image', 'file', 'voice', 'gif', 'sticker']
            && d.reactions == {}
            && (d.kind != 'text' || (d.text is string && d.text.size() > 0 && d.text.size() <= 4000))
            && (d.kind == 'text' || validMedia(d.media))
            && (!('expireAt' in d) || (d.expireAt is timestamp && d.expireAt > request.time && d.expireAt < request.time + duration.value(8, 'd')));
        }

        allow read: if isMemberOf(chatData());
        // getAfter so a brand-new chat and its first message can share a batch.
        allow create: if signedIn()
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members
          && validMessage();
        // Reactions: each member may only set or clear their own.
        allow update: if isMemberOf(chatData())
          && changed().hasOnly(['reactions'])
          && mapChangedOnlyMine('reactions')
          && (!(request.auth.uid in request.resource.data.reactions)
              || (request.resource.data.reactions[request.auth.uid] is string && request.resource.data.reactions[request.auth.uid].size() <= 16));
        // Senders can always delete their own messages; any member can delete expired ones.
        allow delete: if signedIn() && (
          resource.data.senderId == request.auth.uid
          || (resource.data.get('expireAt', null) != null && resource.data.expireAt <= request.time && isMemberOf(chatData()))
        );
      }
    }

    // Account deletion finds my messages across chats.
    match /{path=**}/messages/{messageId} {
      allow list: if signedIn() && resource.data.senderId == request.auth.uid;
    }

    // ---------------------------------------------------------------- calls

    match /calls/{callId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['chatId', 'members', 'callerId', 'calleeId', 'video', 'status', 'startedAt'])
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll([request.auth.uid, request.resource.data.calleeId])
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.video is bool
        && request.resource.data.startedAt == request.time
        && get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members.hasAll(request.resource.data.members);
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && changed().hasOnly(['status', 'answeredAt', 'endedAt'])
        && request.resource.data.status in ['answered', 'declined', 'missed', 'cancelled', 'ended']
        // Only the person being called can answer or decline.
        && (!(request.resource.data.status in ['answered', 'declined']) || request.auth.uid == resource.data.calleeId);
      allow delete: if false;
    }

    // ---------------------------------------------------------------- private per-user data

    // userPrivate/{uid}: FCM tokens and blocked people. Owner only (the Worker uses a service account).
    match /userPrivate/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['tokens', 'blocked', 'updatedAt'])
        && request.resource.data.get('tokens', []).size() <= 10
        && request.resource.data.get('blocked', []).size() <= 500;
    }

    // ---------------------------------------------------------------- sticker packs

    // Shared with everyone on NOOK. Anyone can add a sticker; only the creator can rename or delete.
    match /stickerPacks/{packId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt', 'stickers'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.stickers.size() == 1;
      allow update: if signedIn() && (
        (changed().hasOnly(['stickers'])
          && request.resource.data.stickers.size() == resource.data.stickers.size() + 1
          && request.resource.data.stickers.size() <= 60
          && request.resource.data.stickers[request.resource.data.stickers.size() - 1].addedBy == request.auth.uid)
        || (changed().hasOnly(['name']) && resource.data.createdBy == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30)
      );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
